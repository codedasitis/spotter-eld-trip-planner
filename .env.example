# Copy this file to .env and adjust as needed. Nothing in this file is a
# real secret -- it's committed to the repo on purpose so a cold clone
# has a working local-dev configuration out of the box.

# --- Django backend ---------------------------------------------------

# Any local value works for `docker-compose up`. Set a real, random value
# in production (Render's environment variable settings) -- never commit
# a real SECRET_KEY.
SECRET_KEY=insecure-dev-key-change-in-production

# True for local dev so you get Django's debug pages. Render sets this to
# False (or leaves it unset, since False is the code default).
DEBUG=True

# Comma-separated. Add your deployed backend's hostname here in production.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated list of frontend origins allowed to call this API.
# Update this to your deployed Vercel URL in production -- never set
# CORS_ALLOW_ALL_ORIGINS=True anywhere.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional production hardening -- leave unset locally. Once Render (or
# any TLS-terminating host) confirms the app is only ever served over
# HTTPS, set these to True/a real value there. They default to
# off/0 so they never interfere with plain-http local dev or the test
# client (which is not itself an HTTPS request).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- React frontend (Vite reads VITE_-prefixed vars at build/dev time) -

# Where the frontend sends API requests. Point this at your deployed
# Render URL + /api/v1 in production.
VITE_API_BASE_URL=http://localhost:8000/api/v1
